{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(vp check *)",
      "Bash(vp lint *)",
      "Bash(vp fmt *)",
      "Bash(corepack --version)",
      "Bash(npm ls *)",
      "Bash(corepack use *)",
      "Bash(npm view *)",
      "Bash(vp install *)",
      "Bash(vp test *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git pull *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(vp run *)",
      "Bash(gh issue *)",
      "Bash(vp outdated *)",
      "Bash(vp update *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3000)",
      "Bash(curl -s http://localhost:3000/register -o /dev/null -w \"register page: %{http_code}\\\\n\")",
      "Read(//private/tmp/claude-501/**)",
      "Bash(pkill -f \"next dev\")",
      "Bash(jobs -l)",
      "Bash(vp add *)",
      "Skill(update-config)",
      "Bash(chmod +x *)",
      "Bash(git check-ignore *)",
      "Bash(echo \"exit:$?\")",
      "Bash(claude mcp *)",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_snapshot",
      "mcp__chrome-devtools__lighthouse_audit",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__chrome-devtools__close_page",
      "mcp__playwright__browser_click",
      "Bash(bash .claude/hooks/stop-ui-verify-reminder.sh)"
    ]
  },
  "enabledMcpjsonServers": ["shadcn", "chrome-devtools", "playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/mark-verification-run.sh",
            "timeout": 10,
            "statusMessage": "検証状況を記録中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-ui-verify-reminder.sh",
            "timeout": 10,
            "statusMessage": "UI変更を確認中..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
